{
	"name": "df_silver_viajes",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_viajes_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_viajes_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "filter1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          ViajeId as string,",
				"          RutaHistoricaId as string,",
				"          VehiculoId as string,",
				"          FechaServicio as string,",
				"          HoraProgramada as string,",
				"          HoraSalida as string,",
				"          HoraLlegada as string,",
				"          ValidacionesTarjeta as string,",
				"          KmRecorridos as string,",
				"          EstadoViaje as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(ViajeId = trim(ViajeId),",
				"          ValidacionesTarjeta = toInteger(trim(ValidacionesTarjeta)),",
				"          KmRecorridos = toDecimal(replace(trim(KmRecorridos), ',', '.'), 7, 2),",
				"          EstadoViaje = upper(trim(EstadoViaje))) ~> derivedColumn1",
				"derivedColumn1 derive(FechaServicio = coalesce(toDate(trim(FechaServicio), 'dd/MM/yyyy'), toDate(trim(FechaServicio), 'yyyy-MM-dd')),",
				"          VehiculoId = concat('V-', lpad(regexReplace(trim(VehiculoId), '[^0-9]', ''), 3, '0')),",
				"          RutaHistoricaId = concat('RH-', lpad(regexReplace(trim(RutaHistoricaId), '[^0-9]', ''), 2, '0'), iif(in([7, 12], toInteger(regexReplace(trim(RutaHistoricaId), '[^0-9]', ''))), '-OLD', '')),",
				"          AnioFuente = concat('RH-', lpad(regexReplace(trim(RutaHistoricaId), '[^0-9]', ''), 2, '0'), iif(in([7, 12], toInteger(regexReplace(trim(RutaHistoricaId), '[^0-9]', ''))), '-OLD', ''))) ~> derivedColumn2",
				"derivedColumn2 filter(instr(trim(ViajeId), '-') == 0 && !isNull(toString(byName('ValidacionesTarjeta')))) ~> filter1",
				"filter1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          AnioFuente as integer,",
				"          ViajeId as string,",
				"          RutaHistoricaId as string,",
				"          VehiculoId as string,",
				"          FechaServicio as date,",
				"          HoraProgramada as timestamp,",
				"          HoraSalida as timestamp,",
				"          HoraLlegada as timestamp,",
				"          ValidacionesTarjeta as integer,",
				"          KmRecorridos as decimal(8,1),",
				"          EstadoViaje as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          ViajeId,",
				"          RutaHistoricaId,",
				"          VehiculoId,",
				"          FechaServicio,",
				"          ValidacionesTarjeta,",
				"          KmRecorridos,",
				"          EstadoViaje",
				"     )) ~> sink1"
			]
		}
	}
}