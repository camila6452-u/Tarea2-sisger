{
	"name": "fd_bronze_paradas",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "bronze_paradas_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				},
				{
					"dataset": {
						"referenceName": "bronze_paradas_sql",
						"type": "DatasetReference"
					},
					"name": "source2"
				},
				{
					"dataset": {
						"referenceName": "bronze_paradas_2022_xls",
						"type": "DatasetReference"
					},
					"name": "source3"
				},
				{
					"dataset": {
						"referenceName": "bronze_paradas_2023_xls",
						"type": "DatasetReference"
					},
					"name": "source4"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "select1"
				},
				{
					"name": "select2"
				},
				{
					"name": "select3"
				},
				{
					"name": "union1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          nro_parada as string,",
				"          nombre_parada as string,",
				"          zona as string,",
				"          latitud as string,",
				"          longitud as string,",
				"          fecha_desde as string,",
				"          fecha_hasta as string,",
				"          estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source(output(",
				"          AnioFuente as string,",
				"          ParadaHistoricaId as string,",
				"          CodigoPublicado as string,",
				"          NombreParada as string,",
				"          Zona as string,",
				"          Latitud as string,",
				"          Longitud as string,",
				"          VigenciaDesde as string,",
				"          VigenciaHasta as string,",
				"          Estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source2",
				"source(output(",
				"          nro_parada as string,",
				"          nombre_parada as string,",
				"          zona as string,",
				"          latitud as string,",
				"          longitud as string,",
				"          fecha_desde as string,",
				"          fecha_hasta as string,",
				"          estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source3",
				"source(output(",
				"          nro_parada as string,",
				"          nombre_parada as string,",
				"          zona as string,",
				"          latitud as string,",
				"          longitud as string,",
				"          fecha_desde as string,",
				"          fecha_hasta as string,",
				"          estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source4",
				"source1 select(mapColumn(",
				"          ParadaHistoricaId = nro_parada,",
				"          NombreParada = nombre_parada,",
				"          Zona = zona,",
				"          Latitud = latitud,",
				"          Longitud = longitud,",
				"          VigenciaDesde = fecha_desde,",
				"          VigenciaHasta = fecha_hasta,",
				"          Estado = estado",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"source3 select(mapColumn(",
				"          ParadaHistoricaId = nro_parada,",
				"          NombreParada = nombre_parada,",
				"          Zona = zona,",
				"          Latitud = latitud,",
				"          Longitud = longitud,",
				"          VigenciaDesde = fecha_desde,",
				"          VigenciaHasta = fecha_hasta,",
				"          Estado = estado",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"source4 select(mapColumn(",
				"          ParadaHistoricaId = nro_parada,",
				"          NombreParada = nombre_parada,",
				"          Zona = zona,",
				"          Latitud = latitud,",
				"          Longitud = longitud,",
				"          VigenciaDesde = fecha_desde,",
				"          VigenciaHasta = fecha_hasta,",
				"          Estado = estado",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select3",
				"select1, source2, select2, select3 union(byName: true)~> union1"
			]
		}
	}
}